# ─── .NET build output ──────────────────────────────────────────────────────
**/bin/
**/obj/
**/TestResults/
coverage/

# Visual Studio / VS Code (the shared tasks and launch config are committed)
.vs/
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
*.suo
*.user
*.userosscache
*.sln.docstates

# Rider / JetBrains
.idea/
*.iml

# ─── Claude Code: machine-specific permissions (server paths, sudo rules) ────
.claude/settings.local.json

# ─── Task files: private working notes, local only (ADR-018, ADR-020) ────────
docs/tasks/

# ─── Environment & secrets ──────────────────────────────────────────────────
.env
.env.*
*.env

# ─── ASP.NET secrets / local overrides ──────────────────────────────────────
appsettings.json
appsettings.*.json
!appsettings.template.json

# ─── Certificates ────────────────────────────────────────────────────────────
*.pfx
*.p12
*.cer
*.crt
*.key

# ─── Uploaded PDFs — never commit ───────────────────────────────────────────
*.pdf

# ─── Local runtime data (secrets + backups) — never commit ───────────────────
local/
# SQLite databases live in local/; these catch one created anywhere else.
*.db
*.db-shm
*.db-wal

# ─── Angular / Node ─────────────────────────────────────────────────────────
web/node_modules/
web/dist/
web/.angular/
npm-debug.log*
yarn-error.log*

# ─── Deploy build staging ───────────────────────────────────────────────────
.build/

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ─── OS artifacts ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor swap files ───────────────────────────────────────────────────────
*.swp
*.swo
*~
